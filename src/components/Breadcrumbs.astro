---
type BreadcrumbItem = {
  label: string;
  href?: string;
};

// Remove the current URL path and any trailing slash.
const currentUrlPath = Astro.url.pathname.replace(/\/+$/, "");
const pathSegments = currentUrlPath.split("/").slice(1);

const decodeSegment = (segment: string) => {
  try {
    return decodeURIComponent(segment);
  } catch {
    return segment;
  }
};

const breadcrumbList: BreadcrumbItem[] = (() => {
  const [section, second, third] = pathSegments;

  if (section === "posts") {
    if (second === "page" && third) {
      return [{ label: `Posts (page ${decodeSegment(third)})` }];
    }

    return second
      ? [{ label: "Posts", href: "/posts/" }, { label: decodeSegment(second) }]
      : [{ label: "Posts" }];
  }

  if (section === "tags") {
    if (second && third && !Number.isNaN(Number(third))) {
      const pageLabel = Number(third) === 1 ? "" : ` (page ${third})`;
      return [
        { label: "Tags", href: "/tags/" },
        { label: `${decodeSegment(second)}${pageLabel}` },
      ];
    }

    return second
      ? [{ label: "Tags", href: "/tags/" }, { label: decodeSegment(second) }]
      : [{ label: "Tags" }];
  }

  return pathSegments.map((segment, index) => ({
    label: decodeSegment(segment),
    ...(index < pathSegments.length - 1 && {
      href: `/${pathSegments.slice(0, index + 1).join("/")}/`,
    }),
  }));
})();
---

<nav class="breadcrumb" aria-label="breadcrumb">
  <ul>
    <li>
      <a href="/">Home</a>
      <span aria-hidden="true">&raquo;</span>
    </li>
    {
      breadcrumbList.map(({ label, href }, index) =>
        href ? (
          <li>
            <a href={href}>{label}</a>
            <span aria-hidden="true">&raquo;</span>
          </li>
        ) : (
          <li>
            <span
              class={`${index > 0 ? "lowercase" : "capitalize"}`}
              aria-current="page"
            >
              {label}
            </span>
          </li>
        )
      )
    }
  </ul>
</nav>

<style>
  .breadcrumb {
    @apply mx-auto mb-1 mt-8 w-full max-w-3xl px-4;
  }
  .breadcrumb ul li {
    @apply inline;
  }
  .breadcrumb ul li a {
    @apply capitalize opacity-70;
  }
  .breadcrumb ul li span {
    @apply opacity-70;
  }
  .breadcrumb ul li:not(:last-child) a {
    @apply hover:opacity-100;
  }
</style>
